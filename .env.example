# Backend HTTP base URL (REST).
REACT_APP_API_BASE_URL=http://localhost:5000

# Socket.IO server URL.
REACT_APP_SOCKET_URL=http://localhost:5000

# Allow long-polling fallback for socket.io. Default false (websocket-only).
REACT_APP_SOCKET_ALLOW_POLLING=false

# ─────────────────────────────────────────────────────────────────────────────
# Modular feature subscriptions (Phase 4–6)
# ─────────────────────────────────────────────────────────────────────────────
# Debounce window (ms) used by useSocketSubscriptionSync to collapse rapid
# plan changes (e.g. user toggling tabs/timeframes) into a single
# SUBSCRIBE_ASSET emit. Default 150.
REACT_APP_SUBSCRIPTION_SYNC_DEBOUNCE_MS=150

# Set to "true" to render SubscriptionPlanDebugPanel, which exposes the live
# per-symbol feature/interval refcounts. Dev-only; default false.
REACT_APP_SHOW_SUBSCRIPTION_DEBUG=false

